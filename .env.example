# --- Google Drive (Service Account) ---
# Ścieżka do pliku JSON z kluczem service account ALBO cała zawartość JSON
# wklejona bezpośrednio (przydatne, jeśli hosting pozwala tylko na sekrety
# jako zmienne środowiskowe, bez wgrywania plików).
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# ID dysku udostępnionego (shared drive), z URL: drive.google.com/drive/folders/<...>
# lub z sekcji "Ustawienia dysku" w Google Workspace Admin.
GOOGLE_SHARED_DRIVE_ID=0AbCdEfGhIjklmnopqrstuvwx

# --- Notion ---
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Wersja API Notion (nagłówek Notion-Version) - sprawdź aktualną wartość
# w dokumentacji: https://developers.notion.com/reference/versioning
NOTION_VERSION=2025-09-03

# --- Retencja ---
RETENTION_DAYS=30

# --- Opcjonalne ---
# Ścieżka do lokalnej bazy SQLite śledzącej już zbackupowane wersje
SQLITE_PATH=./backup_state.sqlite3
# Plik z logami (czytany np. przez `tail -f` po uruchomieniu z crona)
LOG_FILE=./backup.log
# Format, do którego eksportowane są natywne pliki Google (Docs/Sheets/Slides)
GOOGLE_EXPORT_MIME_TYPE=application/pdf
# Pliki większe niż ten limit (w bajtach) są pomijane z ostrzeżeniem w logu
MAX_FILE_SIZE_BYTES=209715200
